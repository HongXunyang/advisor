/* Main application styles */

QMainWindow {
    background-color: #F5F5F5;
}

QTabWidget::pane {
    border: 1px solid #C4C4C4;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color:rgb(233, 233, 233);
    border: 1px solid #C4C4C4;
    border-bottom: none;
    min-width: 100px;
    padding: 6px 12px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
}

QTabBar::tab:hover:!selected {
    background-color: #EFEFEF;
}

/* Form elements */
QLineEdit, QComboBox {
    border: 1px solid #C4C4C4;
    border-radius: 3px;
    padding: 4px;
    padding-right: 12x;
    min-height: 24px;
    background-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3D7AAF;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
    border: 1px solid #E0E0E0;
}

QPushButton {
    border: 1px solid #C4C4C4;
    border-radius: 3px;
    padding: 6px 12px;
    background-color: #F0F0F0;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #E6E6E6;
}

QPushButton:pressed {
    background-color: #D6D6D6;
}

QPushButton:disabled {
    color: #888888;
    background-color: #F8F8F8;
}

/* Compact secondary actions around the CIF area (Details…/Use manual
   lattice/Remove CIF/Structures ▾) -- deliberately smaller than the app's
   standard button so this row of secondary actions doesn't compete visually
   with primary controls like "Initialize". */
QPushButton#cifCompactAction, QToolButton#cifCompactAction {
    padding: 3px 8px;
    min-height: 20px;
    font-size: 11px;
}

/* QDoubleSpinBox with plus/minus signs */
QDoubleSpinBox, QSpinBox{
    border: 1px solid #C4C4C4;
    border-radius: 3px;
    padding: 4px;
    padding-right: 20px;
    min-height: 24px;
    background-color: #FFFFFF;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border-left: 1px solid #C4C4C4;
    background-color: #F0F0F0;
}

QDoubleSpinBox::up-button, QSpinBox::up-button{
    subcontrol-position: top right;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-position: bottom right;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover, QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #E6E6E6;
}

QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed, QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #D6D6D6;
}

QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow, QSpinBox::up-arrow, QSpinBox::down-arrow {
    width: 12px;
    height: 12px;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: url(:/icons/plus.svg);
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: url(:/icons/minus.svg);
}


/* Toggle button styles */
QPushButton[text="De-activate"] {
    min-width: 100px;
    background-color: #FFFFFF;  /* White background */
    color: #757575;  /* Dark gray text */
    border: 1px solid #E0E0E0;  /* Light gray border */
}

QPushButton[text="De-activate"]:checked {
    background-color: #FFEBEE;  /* Very light red background */
    color: #C62828;  /* Darker red text */
    border: 1px solid #FFCDD2;  /* Light red border */
}

QPushButton[text="De-activate"]:hover {
    background-color: #F5F5F5;  /* Slightly darker white on hover */
    border: 1px solid #BDBDBD;  /* Slightly darker gray border on hover */
}

QPushButton[text="De-activate"]:checked:hover {
    background-color: #FFCDD2;  /* Slightly darker light red on hover */
    border: 1px solid #EF9A9A;  /* Slightly darker light red border on hover */
}

QPushButton[text="De-activate"]:pressed {
    background-color: #EEEEEE;  /* Even darker white when pressed */
    border: 1px solid #9E9E9E;  /* Even darker gray border when pressed */
}

QPushButton[text="De-activate"]:checked:pressed {
    background-color: #EF9A9A;  /* Even darker light red when pressed */
    border: 1px solid #E57373;  /* Even darker light red border when pressed */
}

/* Group boxes and panels */
QGroupBox {
    border: 1px solid #CCCCCC;
    border-radius: 5px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 3px;
}

/* Status bar */
QStatusBar {
    background-color: #F0F0F0;
    color: #333333;
}

/* Tooltips */
QToolTip {
    border: 1px solid #CCCCCC;
    background-color: #FFFFCC;
    color: #333333;
    padding: 3px;
}

/* Parameter Panel Styles */
QFrame#parameterPanel {
    background-color: #f8f9fa;
    border: 1px solid #c0c0c0;
    border-radius: 8px;
    margin: 2px;
}

QLabel#parameterMainTitle {
    color: #2c3e50;
    font-family: Arial;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 10px;
}

QLabel#parameterSectionTitle {
    color: #34495e;
    font-family: Arial;
    font-size: 14px;
    font-weight: bold;
    margin-top: 5px;
    margin-bottom: 2px;
}

QLabel#parameterText {
    color: #5d6d7e;
    font-family: Arial;
    font-size: 13px;
    margin-left: 15px;
    line-height: 1.3;
}

QPushButton#changeStructureButton {
    background-color: #F0F0F0;
    color: #333333;
    border: 1px solid #C4C4C4;
    border-radius: 3px;
    font-size: 13px;
    padding: 6px;
}

QPushButton#changeStructureButton:hover {
    background-color: #E6E6E6;
}

QPushButton#changeStructureButton:pressed {
    background-color: #D6D6D6;
}

/* Pastel Calculate Button Styles */
QPushButton#calculateButton {
    background-color: #a8d0f0;
    color: #2c5282;
    border-radius: 3px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#calculateButton:hover {
    background-color: #bdd9f3;
}

QPushButton#calculateButton:pressed {
    background-color: #8bc5ea;
}

QPushButton#calculateButton:disabled {
    background-color: #e6e6e6;
    color: #999999;
}

/* Unified Pastel Calculate HKL Button */
QPushButton#calculateHKLButton {
    background-color: #a8d0f0;
    color: #2c5282;
    border-radius: 3px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#calculateHKLButton:hover {
    background-color: #bdd9f3;
}

QPushButton#calculateHKLButton:pressed {
    background-color: #8bc5ea;
}

QPushButton#calculateHKLButton:disabled {
    background-color: #e6e6e6;
    color: #999999;
}

/* Small Clear Button Styles */
QPushButton#clearButton {
    background-color: #f5f5f5;
    color: #666666;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 10px;
    max-height: 24px;
}

QPushButton#clearButton:hover {
    background-color: #ff6b6b;
    color: white;
    border: 1px solid #ee5a52;
}

QPushButton#clearButton:pressed {
    background-color: #ee5a52;
    border: 1px solid #e04848;
}

/* Pastel Toggle Button Styles - Fix χ/φ and Plane Selection */
QPushButton[class="activeToggle"] {
    background-color: #a8e6c1; /* Pastel green - same hue as #2ecc71 but softer */
    color: #2d5a3d; /* Darker green text for better contrast */
    border: 1px solid #FFFFFF;
    border-radius: 3px;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton[class="activeToggle"]:hover {
    background-color: #9de0b7; /* Slightly darker on hover */
    border: 1px solid #85cf9e;
}

QPushButton[class="activeToggle"]:pressed {
    background-color: #92dab0; /* Even darker when pressed */
    border: 1px solid #7bc994;
}

QPushButton[class="inactiveToggle"] {
    background-color: #e8eaec; /* Pastel gray - same hue as #bdc3c7 but softer */
    color: #5a6270; /* Darker gray text for better contrast */
    border: 1px solid #FFFFFF;
    border-radius: 3px;
    padding: 3px 6px;
    font-size: 12px;
}

QPushButton[class="inactiveToggle"]:hover {
    background-color: #dde1e5; /* Slightly darker on hover */
    border: 1px solid #c9cfd5;
}

QPushButton[class="inactiveToggle"]:pressed {
    background-color: #d2d8de; /* Even darker when pressed */
    border: 1px solid #bec6ce;
}


/* HKL Results Table Styling */
QTableWidgetItem[feasible="True"] {
    background-color: #ffffff;  /* White background for feasible solutions */
    color: #333333;
}

QTableWidgetItem[feasible="False"] {
    background-color: #a62d2d;  /* Red background for infeasible solutions */
    color: #333333;
}
/* Initialization and My Structures: explicitly marked controls only.
   These selectors do not restyle the scientific tabs or child dialogs. */
QWidget#setupWindow, QDialog#structureLibrary {
    background-color: #F3F5F7;
    color: #243142;
}
QGroupBox#setupCrystal, QGroupBox[designRole="setupPanel"],
QGroupBox[designRole="previewPanel"], QGroupBox[designRole="libraryPanel"] {
    background-color: #FFFFFF;
    color: #243142;
    border: 1px solid #D6DDE5;
    border-radius: 6px;
    margin-top: 12px;
    font-size: 14px;
    font-weight: bold;
}
QGroupBox#setupCrystal {
    border: 1px solid #3976B9;
    border-top: 3px solid #245FA6;
    color: #245FA6;
}
QGroupBox#setupCrystal::title, QGroupBox[designRole="setupPanel"]::title,
QGroupBox[designRole="previewPanel"]::title, QGroupBox[designRole="libraryPanel"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
}
QGroupBox[designRole="previewPanel"] {
    color: #5E6D7D;
    font-size: 12px;
    font-weight: normal;
}
QFrame#setupSource {
    background-color: #EDF4FC;
    border: 1px solid #D7E5F5;
    border-radius: 5px;
}
QFrame#setupFooter {
    border: none;
    border-top: 1px solid #D6DDE5;
}
QLabel[designRole="sectionTitle"] {
    color: #243142;
    font-weight: bold;
    font-size: 13px;
}
QLabel[designRole="bodyText"] {
    color: #243142;
    font-size: 13px;
    background: transparent;
}
QLabel[designRole="secondaryText"], QLabel[designRole="libraryMetadata"] {
    color: #5E6D7D;
    font-size: 12px;
    background: transparent;
}
QLabel[designRole="emptyState"] {
    color: #5E6D7D;
    background-color: #FFFFFF;
    border: 1px solid #D6DDE5;
    border-radius: 5px;
    padding: 12px;
}
QDoubleSpinBox[designRole="setupField"], QLineEdit[designRole="setupField"] {
    background-color: #FFFFFF;
    color: #243142;
    border: 1px solid #C8D1DD;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 24px;
    font-size: 13px;
}
QDoubleSpinBox[designRole="setupField"] { padding-right: 20px; }
QDoubleSpinBox[designRole="setupField"]:focus, QLineEdit[designRole="setupField"]:focus {
    border: 1px solid #245FA6;
    background-color: #F7FAFF;
}
QDoubleSpinBox[designRole="setupField"]:disabled {
    background-color: #F1F4F8;
    color: #536477;
    border-color: #DEE4EB;
}
QPushButton[designRole="secondaryAction"], QPushButton[designRole="filterSegment"] {
    background-color: #FFFFFF;
    color: #33465B;
    border: 1px solid #C8D1DD;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 24px;
    font-size: 12px;
}
QPushButton[designRole="secondaryAction"]:hover,
QPushButton[designRole="filterSegment"]:hover {
    background-color: #EDF4FC;
    border-color: #3976B9;
}
QPushButton[designRole="secondaryAction"]:focus,
QPushButton[designRole="textAction"]:focus,
QPushButton[designRole="filterSegment"]:focus {
    border: 1px solid #245FA6;
}
QPushButton[designRole="primaryAction"] {
    background-color: #245FA6;
    color: #FFFFFF;
    border: 1px solid #245FA6;
    border-radius: 5px;
    padding: 8px 18px;
    min-height: 26px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton[designRole="primaryAction"]:hover { background-color: #1E528F; }
QPushButton[designRole="primaryAction"]:pressed { background-color: #19457A; }
QPushButton[designRole="primaryAction"]:focus { border: 2px solid #14365E; padding: 7px 17px; }
QPushButton[designRole="primaryAction"]:disabled {
    background-color: #E1E6ED;
    color: #687789;
    border-color: #D6DDE5;
}
QPushButton[designRole="secondaryAction"]:disabled {
    color: #788595;
    background-color: #F3F5F7;
    border-color: #D6DDE5;
}
QPushButton[designRole="textAction"] {
    background: transparent;
    color: #245FA6;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 3px;
    min-height: 18px;
    font-size: 12px;
}
QPushButton[designRole="textAction"]:hover { background-color: #E4EFFB; }
QPushButton[designRole="textAction"]:disabled { color: #788595; }
QPushButton[designRole="filterSegment"] { border-radius: 0; }
QPushButton[segmentPosition="first"] { border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
QPushButton[segmentPosition="last"] { border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
QPushButton[designRole="filterSegment"]:checked {
    background-color: #E4EFFB;
    color: #245FA6;
    border-color: #3976B9;
    font-weight: bold;
}
QListWidget#structureLibraryList {
    background-color: #FFFFFF;
    border: 1px solid #D6DDE5;
    border-radius: 5px;
    outline: none;
}
QListWidget#structureLibraryList:focus { border-color: #245FA6; }
QListWidget#structureLibraryList::item:selected { background-color: #E4EFFB; }
QWidget#libraryRow {
    background-color: #FFFFFF;
    border: none;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #E5EAF0;
}
QWidget#libraryRow[selected="true"] {
    background-color: #E4EFFB;
    border-left-color: #245FA6;
}
QLabel[designRole="libraryName"] {
    background: transparent;
    color: #243142;
    font-weight: bold;
    font-size: 13px;
}
QCheckBox[designRole="quietCheck"] { color: #5E6D7D; font-size: 12px; spacing: 7px; }
QCheckBox[designRole="quietCheck"]::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #99A9BC;
    border-radius: 3px;
    background-color: #FFFFFF;
}
QCheckBox[designRole="quietCheck"]::indicator:checked {
    background-color: #245FA6;
    border-color: #245FA6;
    image: url(:/icons/check.svg);
}
QCheckBox[designRole="quietCheck"]:focus { color: #245FA6; }
QCheckBox[designRole="quietCheck"]::indicator:disabled { background-color: #E1E6ED; border-color: #C8D1DD; }
